{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classification-event.schema.json",
  "title": "Classification Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "action",
    "paper_id",
    "taxonomy_id",
    "node_id",
    "status",
    "reason",
    "evidence",
    "proposal_id",
    "taxonomy_version",
    "created_at"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^ce_[a-z0-9_-]+$"},
    "action": {"enum": ["assign", "revoke", "replace", "confirm"]},
    "paper_id": {"type": "string", "pattern": "^p_[a-z0-9_]+$"},
    "taxonomy_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "node_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "status": {"const": "approved"},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "integer", "minimum": 1},
    "supersedes_event_id": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
