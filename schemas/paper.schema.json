{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper.schema.json",
  "title": "Paper",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "title",
    "year",
    "earliest_public_date",
    "earliest_public_date_precision",
    "venue",
    "publication_type",
    "identifiers",
    "links",
    "authors",
    "abstract",
    "ai_summary",
    "knowledge_base",
    "attributes",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "paper_id": {"type": "string", "pattern": "^p_[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "year": {"type": ["integer", "null"]},
    "earliest_public_date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "earliest_public_date_precision": {"enum": ["day", "month", "year"]},
    "venue": {"type": ["string", "null"]},
    "publication_type": {"type": ["string", "null"]},
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doi": {"type": ["string", "null"]},
        "arxiv_id": {"type": ["string", "null"]},
        "openreview_id": {"type": ["string", "null"]}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]},
      "properties": {
        "pdf": {"type": ["string", "null"], "format": "uri"},
        "primary": {"type": ["string", "null"], "format": "uri"},
        "code": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author_id", "name", "position", "roles", "affiliations"],
        "properties": {
          "author_id": {"type": "string", "pattern": "^a_[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 1},
          "roles": {
            "type": "array",
            "items": {"enum": ["first", "middle", "last", "corresponding", "co-first", "co-last"]},
            "uniqueItems": true
          },
          "affiliations": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "abstract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_url", "en", "zh", "translation"],
      "properties": {
        "source": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "en": {"type": ["string", "null"]},
        "zh": {"type": ["string", "null"]},
        "translation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "translated_by", "third_party_api_used"],
          "properties": {
            "status": {"enum": ["pending", "complete", "needs_review"]},
            "translated_by": {"type": ["string", "null"]},
            "third_party_api_used": {"const": false}
          }
        }
      }
    },
    "ai_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "en", "zh", "generation"],
      "properties": {
        "basis": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1},
        "zh": {"type": "string", "minLength": 1},
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "generated_by", "generated_at", "third_party_api_used"],
          "properties": {
            "status": {"enum": ["complete", "needs_review"]},
            "generated_by": {"type": "string", "minLength": 1},
            "generated_at": {"type": "string", "format": "date"},
            "third_party_api_used": {"const": false}
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_role", "evidence_strength", "modality"],
      "properties": {
        "contribution_role": {
          "description": "The paper's primary contribution to the literature.",
          "enum": ["method", "empirical-discovery", "theory", "evaluation", "application"]
        },
        "evidence_strength": {
          "description": "The evidential level supporting the paper's central mechanistic claim.",
          "enum": ["descriptive", "decodable", "sensitivity", "causal-local", "causal-structural", "formal", "audit"]
        },
        "modality": {
          "description": "The primary data modality in which the paper's central claim is established.",
          "enum": ["language", "vision", "vision-language", "biological-sequence", "architecture-agnostic"]
        }
      }
    },
    "knowledge_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "has_pdf", "has_docling_fulltext"],
      "properties": {
        "record_id": {"type": "string"},
        "has_pdf": {"type": "boolean"},
        "has_docling_fulltext": {"type": "boolean"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["imported_from", "imported_at"],
      "properties": {
        "imported_from": {"type": "string"},
        "imported_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
